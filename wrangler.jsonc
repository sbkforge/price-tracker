{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "price-tracker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Forks: replace this id with your own from `wrangler d1 create price-tracker`.
  "d1_databases": [
    { "binding": "DB", "database_name": "price-tracker", "database_id": "980dd9b9-016d-4585-8448-f88c2122295e" }
  ],
  // Every 15 minutes, re-check up to 25 products not checked in 6 hours.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Public half of the VAPID key pair (the private half is a secret).
  "vars": { "VAPID_PUBLIC_KEY": "BMoSJAb1g_2kizuw0aoooBRVBmv1Wya8p2fJIfFjDgfuGrNZVo8TueDpMJaQvMOiAJUpf2wGnp3s0A7-h8LlfsQ", "VAPID_SUBJECT": "https://price-tracker.sbkforge.workers.dev" },
  // Free-plan Browser Rendering: a real browser for stores that load prices with JavaScript.
  "browser": { "binding": "BROWSER" },
  "observability": { "enabled": true }
}
