{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "price-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Forks: replace this id with your own from `wrangler d1 create price-tracker`.
  "d1_databases": [
    { "binding": "DB", "database_name": "price-tracker", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  // Check prices hourly; each run re-checks products not checked in 6 hours.
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
